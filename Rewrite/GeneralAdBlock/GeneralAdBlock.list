hostname = *.manhuashe.com, api.gamer.com.tw, config.mobile.yahoo.com, meta.wikimedia.org, service.thim.immigration.go.th, userside-api.mfoodapp.com, www.google.com, zh.wikipedia.org

# Bahamut
^https:\/\/api\.gamer\.com\.tw\/(?:mobile_app\/anime\/v\d\/(?:token|m3u8)|anime\/v\d\/video_src)\.php(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/kewachan/Quantumult-X/main/Rewrite/GeneralAdBlock/bahamut-adblock.js

# Google
^https?:\/\/(www\.)?google\.[^\/]+\/search(?:\/.*)?(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/kewachan/Quantumult-X/main/Rewrite/GeneralAdBlock/google-adblock.js

# Manhuashe
^https?:\/\/comicapi\.manhuashe\.com\/v\d\/.+?$ url script-response-body https://raw.githubusercontent.com/kewachan/Quantumult-X/main/Rewrite/GeneralAdBlock/manhuashe-adblock.js

# THIM
^https:\/\/service\.thim\.immigration\.go\.th\/api\/v1\/explore\/coupons\/exclusive-banners(?:\?[^#]*)?$ url script-response-body https://raw.githubusercontent.com/kewachan/Quantumult-X/main/Rewrite/GeneralAdBlock/thim-adblock.js

# mFood Request
^https:\/\/userside-api\.mfoodapp\.com\/(?:orgs\/basic\/banner\/(?:_list_spread-compress|_special_list|_list_suspend)|market\/user_side\/pop\/(?:_comprehensive_pop_list|getGroupPopList))(?:\?.*)?$ url script-echo-response https://raw.githubusercontent.com/kewachan/Quantumult-X/main/Rewrite/GeneralAdBlock/mfood-adblock.js

# mFood
^https:\/\/userside-api\.mfoodapp\.com\/(?:orgs\/basic\/banner\/(?:_list_spread-compress|_special_list|_list_suspend)|market\/user_side\/pop\/(?:_comprehensive_pop_list|getGroupPopList))(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/kewachan/Quantumult-X/main/Rewrite/GeneralAdBlock/mfood-adblock.js

# Wikipedia
^https?:\/\/(?:zh\.wikipedia\.org\/w\/load\.php\?.*modules=ext\.gadget\.VariantAllyDialog(?:&.*)?|zh\.wikipedia\.org\/w\/api\.php\?.*page=Template(?:%3A|:)AdvancedSiteNotices(?:%2F|\/)ajax(?:&.*)?|meta\.wikimedia\.org\/w\/index\.php\?.*title=Special(?:%3A|:)BannerLoader(?:&.*)?)$ url script-response-body https://raw.githubusercontent.com/kewachan/Quantumult-X/main/Rewrite/GeneralAdBlock/wikipedia-adblock.js

# Yahoo Finance Request
^https:\/\/config\.mobile\.yahoo\.com\/V3\/getconfig(?:\?.*)?$ url script-request-header https://raw.githubusercontent.com/kewachan/Quantumult-X/main/Rewrite/GeneralAdBlock/yahoo-finance-adblock.js

# Yahoo Finance
^https:\/\/config\.mobile\.yahoo\.com\/V3\/getconfig(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/kewachan/Quantumult-X/main/Rewrite/GeneralAdBlock/yahoo-finance-adblock.js
