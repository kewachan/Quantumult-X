hostname = ani.gamer.com.tw, *.manhuashe.com, api.gamer.com.tw, config.mobile.yahoo.com, meta.wikimedia.org, service.thim.immigration.go.th, userside-api.mfoodapp.com, www.google.com, zh.wikipedia.org, gql-fed.reddit.com, gql.reddit.com, legy.line-apps.com, pay.macaupass.com, service.global.thim.immigration.go.th

^https:\/\/ani\.gamer\.com\.tw\/(?:\?|$|animeVideo\.php(?:\?|$)|animeList\.php(?:\?|$)|animeRef\.php(?:\?|$)|ajax\/token\.php(?:\?|$)) url script-response-body https://raw.githubusercontent.com/kewachan/Quantumult-X/main/Rewrite/Desktop/desktop.web.js

# Bahamut
^https:\/\/api\.gamer\.com\.tw\/(?:mobile_app\/anime\/v\d\/(?:token|m3u8)|anime\/v\d\/video_src)\.php(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/kewachan/Quantumult-X/main/Rewrite/GeneralAdBlock/bahamut-adblock.js?v=1.1.1

# Google
^https?:\/\/(www\.)?google\.[^\/]+\/search(?:\/.*)?(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/kewachan/Quantumult-X/main/Rewrite/GeneralAdBlock/google-adblock.js?v=1.0.19

# Manhuashe
^https?:\/\/comicapi\.manhuashe\.com\/v\d\/.+?$ url script-response-body https://raw.githubusercontent.com/kewachan/Quantumult-X/main/Rewrite/GeneralAdBlock/manhuashe-adblock.js?v=1.0.2

^https:\/\/legy\.line-apps\.com(?::443)?\/S4(?:\?[^#]*)?$ url script-response-body https://raw.githubusercontent.com/kewachan/Quantumult-X/main/Rewrite/GeneralAdBlock/line-adblock.js?v=1.0.0

^https:\/\/pay\.macaupass\.com\/tdrmp\/appMenu\/getAppMenu\.do(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/kewachan/Quantumult-X/main/Rewrite/GeneralAdBlock/mpay-adblock.js?v=1.0.6

^https:\/\/gql(?:-fed)?\.reddit\.com(?:\/.*)?$ url script-response-body https://raw.githubusercontent.com/kewachan/Quantumult-X/main/Rewrite/GeneralAdBlock/reddit-adblock.js?v=1.0.0

# THIM
^https:\/\/service(?:\.global)?\.thim\.immigration\.go\.th\/api\/v1\/explore\/coupons\/exclusive-banners(?:\?[^#]*)?$ url script-response-body https://raw.githubusercontent.com/kewachan/Quantumult-X/main/Rewrite/GeneralAdBlock/thim-adblock.js?v=1.0.3

# mFood Request
^https:\/\/userside-api\.mfoodapp\.com\/(?:orgs\/basic\/banner\/(?:_list_spread-compress|_special_list|_new_special_list|_list_suspend|_list_smart|bottom\/banner\/_list)|orgs\/banner\/advertisement\/(?:_get_banner_list|_get_advertisement_list|_activity_advertisement_list)|market\/user_side\/pop\/(?:_comprehensive_pop_list|getGroupPopList|_get_pop_list)|market\/user_side\/banner\/_get_banner_list|market\/market\/zone\/_new-people-ad|activity\/activity\/topPop\/list|activity\/userActivity\/getPop)(?:\?.*)?$ url script-echo-response https://raw.githubusercontent.com/kewachan/Quantumult-X/main/Rewrite/GeneralAdBlock/mfood-adblock.js?v=1.5.1

# mFood
^https:\/\/userside-api\.mfoodapp\.com\/(?:orgs\/basic\/banner\/(?:_list_spread-compress|_special_list|_new_special_list|_list_suspend|_list_smart|bottom\/banner\/_list)|orgs\/banner\/advertisement\/(?:_get_banner_list|_get_advertisement_list|_activity_advertisement_list)|market\/user_side\/pop\/(?:_comprehensive_pop_list|getGroupPopList|_get_pop_list)|market\/user_side\/banner\/_get_banner_list|market\/market\/zone\/_new-people-ad|activity\/activity\/topPop\/list|activity\/userActivity\/getPop)(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/kewachan/Quantumult-X/main/Rewrite/GeneralAdBlock/mfood-adblock.js?v=1.5.1

# Wikipedia
^https?:\/\/(?:zh\.wikipedia\.org\/w\/load\.php\?.*modules=ext\.gadget\.VariantAllyDialog(?:&.*)?|zh\.wikipedia\.org\/w\/api\.php\?.*page=Template(?:%3A|:)AdvancedSiteNotices(?:%2F|\/)ajax(?:&.*)?|meta\.wikimedia\.org\/w\/index\.php\?.*title=Special(?:%3A|:)BannerLoader(?:&.*)?)$ url script-response-body https://raw.githubusercontent.com/kewachan/Quantumult-X/main/Rewrite/GeneralAdBlock/wikipedia-adblock.js?v=1.0.1

# Yahoo Finance Request
^https:\/\/config\.mobile\.yahoo\.com\/V3\/getconfig(?:\?.*)?$ url script-request-header https://raw.githubusercontent.com/kewachan/Quantumult-X/main/Rewrite/GeneralAdBlock/yahoo-finance-adblock.js?v=1.0.0

# Yahoo Finance
^https:\/\/config\.mobile\.yahoo\.com\/V3\/getconfig(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/kewachan/Quantumult-X/main/Rewrite/GeneralAdBlock/yahoo-finance-adblock.js?v=1.0.0
