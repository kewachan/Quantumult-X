hostname = www.bilibili.com, manga.bilibili.com, api.live.bilibili.com, api.vc.bilibili.com, app.bilibili.com, app.biliapi.net, api.bilibili.com, api.biliapi.net, grpc.biliapi.net

^https:\/\/www\.bilibili\.com\/(?:(?:en|zh-(?:Hans|Hant))(?:\/|(?=\?|$)))?(?:\?|$|video\/|bangumi\/play\/) url script-response-body https://raw.githubusercontent.com/kewachan/Quantumult-X/main/Rewrite/Desktop/desktop.web.js?v=20261025-2
^https:\/\/api\.bilibili\.com\/(?:x\/web-interface\/index\/top\/feed\/rcmd|x\/web-show\/res\/locs)(?:\?|$) url script-response-body https://raw.githubusercontent.com/kewachan/Quantumult-X/main/Rewrite/Desktop/desktop.web.js?v=20261025-2

# 移除搜尋中的預設關鍵詞
^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.interface\.v1\.Search\/DefaultWords$ url reject
# 阻擋影片播放暫停回報
^https:\/\/(?:app\.bilibili\.com|grpc\.biliapi\.net)\/bilibili\.app\.(view|viewunite)\.v1\.View\/PlayPause$ url reject

^https?:\/\/api\.vc\.bilibili\.com\/search_svr\/v\d\/Search\/recommend_words url reject-dict

^https?:\/\/api\.vc\.bilibili\.com\/topic_svr\/v1\/topic_svr url reject-dict

^https?:\/\/api\.vc\.bilibili\.com\/dynamic_svr\/v1\/dynamic_svr\/mix_uplist url reject-dict

^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/Flash url reject-dict

^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/ListFlash url reject-dict

^https?:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v1\/ecommerce-user\/get_shopping_info\? url reject-dict

^https:\/\/api\.bilibili\.com\/pgc\/activity\/deliver\/material\/receive\? url script-echo-response https://raw.githubusercontent.com/kewachan/Quantumult-X/main/Rewrite/Bilibili/bilibili.material.response.js

^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.viewunite\.v1\.View\/AIRelateAsync(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/kewachan/Quantumult-X/main/Rewrite/Bilibili/bilibili.viewunite.response.js?v=20261017-2

^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/resource\/show\/tab\/v2\? url script-response-body https://github.com/BiliUniverse/Enhanced/releases/download/v0.5.13/response.bundle.js

^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/account\/mine(\/ipad)?\? url script-response-body https://github.com/BiliUniverse/Enhanced/releases/download/v0.5.13/response.bundle.js

^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/region\/index\? url script-response-body https://github.com/BiliUniverse/Enhanced/releases/download/v0.5.13/response.bundle.js

